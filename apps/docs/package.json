{
  "name": "@clawscale/docs",
  "version": "0.1.0",
  "private": true,
  "description": "Documentation site and showcase for Clawscale.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "dev": "pnpm generate && next dev --port 3100",
    "build": "pnpm generate && next build",
    "start": "node e2e/serve.mjs out 3100",
    "typecheck": "pnpm generate && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:audit": "A11Y_ALL=1 COLORS_ALL=1 playwright test e2e/a11y-all.spec.ts e2e/colors-all.spec.ts",
    "screenshots": "SCREENSHOTS=1 playwright test e2e/screenshots.spec.ts"
  },
  "dependencies": {
    "@clawscale/react": "workspace:^",
    "@clawscale/tokens": "workspace:^",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.3.6",
    "github-slugger": "^2.0.0",
    "next": "16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
