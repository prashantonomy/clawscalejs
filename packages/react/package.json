{
  "name": "@clawscale/react",
  "version": "0.1.0",
  "description": "Clawscale for React: Blueprint's data-dense components with a refined look, ready for Next.js.",
  "keywords": [
    "clawscale",
    "blueprint",
    "react",
    "nextjs",
    "design-system",
    "components",
    "data-dense"
  ],
  "license": "Apache-2.0",
  "homepage": "https://prashantonomy.github.io/clawscalejs/",
  "bugs": "https://github.com/prashantonomy/clawscalejs/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prashantonomy/clawscalejs.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/sync-icons.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./select": {
      "types": "./dist/select.d.ts",
      "default": "./dist/select.js"
    },
    "./datetime": {
      "types": "./dist/datetime.d.ts",
      "default": "./dist/datetime.js"
    },
    "./table": {
      "types": "./dist/table.d.ts",
      "default": "./dist/table.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "default": "./dist/icons.js"
    },
    "./common": {
      "types": "./dist/common.d.ts",
      "default": "./dist/common.js"
    },
    "./sync-icons": {
      "types": "./dist/sync-icons.d.ts",
      "default": "./dist/sync-icons.js"
    },
    "./styles.css": "./dist/styles.css",
    "./fonts.css": "./dist/fonts.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "generate": "tsx scripts/generate-exports.ts && tsx scripts/generate-table-borders.ts && tsx scripts/generate-dark-text.ts",
    "build": "tsc -p tsconfig.build.json && tsx scripts/build-css.ts",
    "dev": "tsx scripts/dev.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@blueprintjs/colors": "5.1.16",
    "@blueprintjs/core": "6.20.0",
    "@blueprintjs/datetime": "6.2.6",
    "@blueprintjs/icons": "6.14.1",
    "@blueprintjs/select": "6.3.6",
    "@blueprintjs/table": "6.2.6",
    "@clawscale/tokens": "workspace:^",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0"
  },
  "peerDependencies": {
    "@types/react": "^18.2.0 || ^19.0.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "lightningcss": "^1.33.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vitest": "^5.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
